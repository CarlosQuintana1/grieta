{
  "info": {
    "name": "Grieta API (local)",
    "description": "Las 20 rutas de la API en http://localhost:3000/api. Antes: npm start en la carpeta del proyecto. Se pueden correr todas en orden con Run collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base",
      "value": "http://localhost:3000/api"
    },
    {
      "key": "lugar_id",
      "value": ""
    },
    {
      "key": "usuario_id",
      "value": ""
    },
    {
      "key": "registro_id",
      "value": ""
    },
    {
      "key": "origen_id",
      "value": ""
    },
    {
      "key": "destino_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Salud",
      "item": [
        {
          "name": "API en línea",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/salud"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ok es true\", () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Lugares",
      "item": [
        {
          "name": "Listar lugares",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/lugares"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae los 16 del catálogo\", () => pm.expect(pm.response.json().length).to.be.at.least(16));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver un lugar",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/lugares/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear lugar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/lugares",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clave\": \"demo-{{$timestamp}}\",\n  \"nombre\": \"Lugar de demostración\",\n  \"lat\": 20.5888,\n  \"lon\": -100.3899\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"lugar_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Modificar lugar",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/lugares/{{lugar_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Lugar renombrado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Cambió el nombre\", () => pm.expect(pm.response.json().nombre).to.eql(\"Lugar renombrado\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Borrar lugar",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{base}}/lugares/{{lugar_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 204\", () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Lugar borrado ya no existe",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/lugares/{{lugar_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Rutas",
      "item": [
        {
          "name": "Listar rutas",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/rutas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae las 32 con origen y destino\", () => { const r = pm.response.json(); pm.expect(r.length).to.eql(32); pm.expect(r[0].origen.nombre).to.be.a(\"string\"); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver la ruta 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/rutas/1"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.collectionVariables.set(\"origen_id\", r.origen_id);",
                  "pm.collectionVariables.set(\"destino_id\", r.destino_id);"
                ]
              }
            }
          ]
        }
      ]
    },
