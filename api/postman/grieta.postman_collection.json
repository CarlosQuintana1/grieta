        {
          "name": "Modificar usuario",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/usuarios/{{usuario_id}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Capturista renombrado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Registros y cotizaciones",
      "item": [
        {
          "name": "Guardar registro con tres precios",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/registros",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruta_id\": 1,\n  \"usuario_id\": {{usuario_id}},\n  \"temperatura_c\": 22.5,\n  \"lluvia_mm\": 0,\n  \"cotizaciones\": [\n    { \"app\": \"uber\", \"precio\": 59.95 },\n    { \"app\": \"didi\", \"precio\": 48 },\n    { \"app\": \"indrive\", \"precio\": 52 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Guardó las tres cotizaciones\", () => pm.expect(pm.response.json().cotizaciones.length).to.eql(3));",
                  "pm.collectionVariables.set(\"registro_id\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Rechazo: una sola app",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{base}}/registros",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ruta_id\": 1,\n  \"usuario_id\": {{usuario_id}},\n  \"cotizaciones\": [\n    { \"app\": \"uber\", \"precio\": 59.95 }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 400: se necesitan al menos dos apps\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar registros",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/registros"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver un registro",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/registros/{{registro_id}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Trae su ruta y sus precios\", () => { const r = pm.response.json(); pm.expect(r.ruta.origen.nombre).to.be.a(\"string\"); pm.expect(r.cotizaciones.length).to.eql(3); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Precios del registro, del más barato al más caro",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/registros/{{registro_id}}/cotizaciones"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El primero es DiDi, el más barato\", () => pm.expect(pm.response.json()[0].app).to.eql(\"didi\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Consultas al agente",
