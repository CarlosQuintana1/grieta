      "name": "Salud",
      "item": [
        {
          "name": "API en línea",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base}}/salud"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ok es true\", () => pm.expect(pm.response.json().ok).to.eql(true));"
                ]
              }
            }
          ]
        }
      ]
